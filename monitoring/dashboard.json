{
  "displayName": "shipit — Cloud Run",
  "labels": {
    "app": ""
  },
  "mosaicLayout": {
    "columns": 48,
    "tiles": [
      {
        "height": 3,
        "widget": {
          "text": {
            "content": "**shipit** · Cloud Run `northamerica-northeast1` · [live site](https://shipit-116485471187.northamerica-northeast1.run.app) · [repo](https://github.com/soonland/shipit) · scales to zero when idle, so gaps in the charts are normal.",
            "format": "MARKDOWN",
            "style": {}
          }
        },
        "width": 48
      },
      {
        "height": 8,
        "widget": {
          "scorecard": {
            "sparkChartView": {
              "sparkChartType": "SPARK_LINE"
            },
            "thresholds": [
              {
                "color": "YELLOW",
                "direction": "BELOW",
                "value": 0.99
              },
              {
                "color": "RED",
                "direction": "BELOW",
                "value": 0.9
              }
            ],
            "timeSeriesQuery": {
              "timeSeriesFilter": {
                "aggregation": {
                  "alignmentPeriod": "300s",
                  "crossSeriesReducer": "REDUCE_MEAN",
                  "perSeriesAligner": "ALIGN_FRACTION_TRUE"
                },
                "filter": "metric.type=\"monitoring.googleapis.com/uptime_check/check_passed\" AND resource.type=\"uptime_url\" AND metric.label.check_id=\"shipit-health-mPyRhihDCZ4\""
              }
            }
          },
          "title": "Uptime /health (% passing)"
        },
        "width": 12,
        "yPos": 3
      },
      {
        "height": 8,
        "widget": {
          "scorecard": {
            "sparkChartView": {
              "sparkChartType": "SPARK_LINE"
            },
            "timeSeriesQuery": {
              "timeSeriesFilter": {
                "aggregation": {
                  "alignmentPeriod": "300s",
                  "crossSeriesReducer": "REDUCE_SUM",
                  "perSeriesAligner": "ALIGN_DELTA"
                },
                "filter": "metric.type=\"run.googleapis.com/request_count\" AND resource.type=\"cloud_run_revision\" AND resource.labels.service_name=\"shipit\""
              }
            }
          },
          "title": "Requests (per 5 min)"
        },
        "width": 12,
        "xPos": 12,
        "yPos": 3
      },
      {
        "height": 8,
        "widget": {
          "scorecard": {
            "sparkChartView": {
              "sparkChartType": "SPARK_LINE"
            },
            "timeSeriesQuery": {
              "timeSeriesFilter": {
                "aggregation": {
                  "alignmentPeriod": "300s",
                  "crossSeriesReducer": "REDUCE_MAX",
                  "perSeriesAligner": "ALIGN_PERCENTILE_95"
                },
                "filter": "metric.type=\"run.googleapis.com/request_latencies\" AND resource.type=\"cloud_run_revision\" AND resource.labels.service_name=\"shipit\""
              }
            }
          },
          "title": "Latency p95 (ms)"
        },
        "width": 12,
        "xPos": 24,
        "yPos": 3
      },
      {
        "height": 8,
        "widget": {
          "scorecard": {
            "sparkChartView": {
              "sparkChartType": "SPARK_LINE"
            },
            "thresholds": [
              {
                "color": "RED",
                "direction": "ABOVE",
                "value": 1.0
              }
            ],
            "timeSeriesQuery": {
              "timeSeriesFilter": {
                "aggregation": {
                  "alignmentPeriod": "300s",
                  "crossSeriesReducer": "REDUCE_SUM",
                  "perSeriesAligner": "ALIGN_DELTA"
                },
                "filter": "metric.type=\"run.googleapis.com/request_count\" AND resource.type=\"cloud_run_revision\" AND resource.labels.service_name=\"shipit\" AND metric.labels.response_code_class=\"5xx\""
              }
            }
          },
          "title": "5xx errors (per 5 min)"
        },
        "width": 12,
        "xPos": 36,
        "yPos": 3
      },
      {
        "height": 16,
        "widget": {
          "title": "Requests by response class",
          "xyChart": {
            "dataSets": [
              {
                "legendTemplate": "${metric.labels.response_code_class}",
                "plotType": "STACKED_BAR",
                "targetAxis": "Y1",
                "timeSeriesQuery": {
                  "timeSeriesFilter": {
                    "aggregation": {
                      "alignmentPeriod": "60s",
                      "crossSeriesReducer": "REDUCE_SUM",
                      "groupByFields": [
                        "metric.label.response_code_class"
                      ],
                      "perSeriesAligner": "ALIGN_RATE"
                    },
                    "filter": "metric.type=\"run.googleapis.com/request_count\" AND resource.type=\"cloud_run_revision\" AND resource.labels.service_name=\"shipit\""
                  }
                }
              }
            ],
            "timeshiftDuration": "0s",
            "yAxis": {
              "label": "req/s",
              "scale": "LINEAR"
            }
          }
        },
        "width": 24,
        "yPos": 11
      },
      {
        "height": 16,
        "widget": {
          "title": "Request latency (p50 / p95 / p99)",
          "xyChart": {
            "dataSets": [
              {
                "legendTemplate": "p50",
                "plotType": "LINE",
                "targetAxis": "Y1",
                "timeSeriesQuery": {
                  "timeSeriesFilter": {
                    "aggregation": {
                      "alignmentPeriod": "60s",
                      "crossSeriesReducer": "REDUCE_MAX",
                      "perSeriesAligner": "ALIGN_PERCENTILE_50"
                    },
                    "filter": "metric.type=\"run.googleapis.com/request_latencies\" AND resource.type=\"cloud_run_revision\" AND resource.labels.service_name=\"shipit\""
                  }
                }
              },
              {
                "legendTemplate": "p95",
                "plotType": "LINE",
                "targetAxis": "Y1",
                "timeSeriesQuery": {
                  "timeSeriesFilter": {
                    "aggregation": {
                      "alignmentPeriod": "60s",
                      "crossSeriesReducer": "REDUCE_MAX",
                      "perSeriesAligner": "ALIGN_PERCENTILE_95"
                    },
                    "filter": "metric.type=\"run.googleapis.com/request_latencies\" AND resource.type=\"cloud_run_revision\" AND resource.labels.service_name=\"shipit\""
                  }
                }
              },
              {
                "legendTemplate": "p99",
                "plotType": "LINE",
                "targetAxis": "Y1",
                "timeSeriesQuery": {
                  "timeSeriesFilter": {
                    "aggregation": {
                      "alignmentPeriod": "60s",
                      "crossSeriesReducer": "REDUCE_MAX",
                      "perSeriesAligner": "ALIGN_PERCENTILE_99"
                    },
                    "filter": "metric.type=\"run.googleapis.com/request_latencies\" AND resource.type=\"cloud_run_revision\" AND resource.labels.service_name=\"shipit\""
                  }
                }
              }
            ],
            "timeshiftDuration": "0s",
            "yAxis": {
              "label": "ms",
              "scale": "LINEAR"
            }
          }
        },
        "width": 24,
        "xPos": 24,
        "yPos": 11
      },
      {
        "height": 16,
        "widget": {
          "title": "Instances (active vs idle)",
          "xyChart": {
            "dataSets": [
              {
                "legendTemplate": "${metric.labels.state}",
                "plotType": "STACKED_AREA",
                "targetAxis": "Y1",
                "timeSeriesQuery": {
                  "timeSeriesFilter": {
                    "aggregation": {
                      "alignmentPeriod": "60s",
                      "crossSeriesReducer": "REDUCE_SUM",
                      "groupByFields": [
                        "metric.label.state"
                      ],
                      "perSeriesAligner": "ALIGN_MAX"
                    },
                    "filter": "metric.type=\"run.googleapis.com/container/instance_count\" AND resource.type=\"cloud_run_revision\" AND resource.labels.service_name=\"shipit\""
                  }
                }
              }
            ],
            "timeshiftDuration": "0s",
            "yAxis": {
              "label": "instances",
              "scale": "LINEAR"
            }
          }
        },
        "width": 24,
        "yPos": 27
      },
      {
        "height": 16,
        "widget": {
          "title": "Cold starts: container startup latency",
          "xyChart": {
            "dataSets": [
              {
                "legendTemplate": "p50",
                "plotType": "LINE",
                "targetAxis": "Y1",
                "timeSeriesQuery": {
                  "timeSeriesFilter": {
                    "aggregation": {
                      "alignmentPeriod": "300s",
                      "crossSeriesReducer": "REDUCE_MAX",
                      "perSeriesAligner": "ALIGN_PERCENTILE_50"
                    },
                    "filter": "metric.type=\"run.googleapis.com/container/startup_latencies\" AND resource.type=\"cloud_run_revision\" AND resource.labels.service_name=\"shipit\""
                  }
                }
              },
              {
                "legendTemplate": "p99",
                "plotType": "LINE",
                "targetAxis": "Y1",
                "timeSeriesQuery": {
                  "timeSeriesFilter": {
                    "aggregation": {
                      "alignmentPeriod": "300s",
                      "crossSeriesReducer": "REDUCE_MAX",
                      "perSeriesAligner": "ALIGN_PERCENTILE_99"
                    },
                    "filter": "metric.type=\"run.googleapis.com/container/startup_latencies\" AND resource.type=\"cloud_run_revision\" AND resource.labels.service_name=\"shipit\""
                  }
                }
              }
            ],
            "timeshiftDuration": "0s",
            "yAxis": {
              "label": "ms",
              "scale": "LINEAR"
            }
          }
        },
        "width": 24,
        "xPos": 24,
        "yPos": 27
      },
      {
        "height": 16,
        "widget": {
          "title": "CPU utilization (p95)",
          "xyChart": {
            "dataSets": [
              {
                "legendTemplate": "cpu p95",
                "plotType": "LINE",
                "targetAxis": "Y1",
                "timeSeriesQuery": {
                  "timeSeriesFilter": {
                    "aggregation": {
                      "alignmentPeriod": "60s",
                      "crossSeriesReducer": "REDUCE_MAX",
                      "perSeriesAligner": "ALIGN_PERCENTILE_95"
                    },
                    "filter": "metric.type=\"run.googleapis.com/container/cpu/utilizations\" AND resource.type=\"cloud_run_revision\" AND resource.labels.service_name=\"shipit\""
                  }
                }
              }
            ],
            "timeshiftDuration": "0s"
          }
        },
        "width": 16,
        "yPos": 43
      },
      {
        "height": 16,
        "widget": {
          "title": "Memory utilization (p95)",
          "xyChart": {
            "dataSets": [
              {
                "legendTemplate": "memory p95",
                "plotType": "LINE",
                "targetAxis": "Y1",
                "timeSeriesQuery": {
                  "timeSeriesFilter": {
                    "aggregation": {
                      "alignmentPeriod": "60s",
                      "crossSeriesReducer": "REDUCE_MAX",
                      "perSeriesAligner": "ALIGN_PERCENTILE_95"
                    },
                    "filter": "metric.type=\"run.googleapis.com/container/memory/utilizations\" AND resource.type=\"cloud_run_revision\" AND resource.labels.service_name=\"shipit\""
                  }
                }
              }
            ],
            "timeshiftDuration": "0s"
          }
        },
        "width": 16,
        "xPos": 16,
        "yPos": 43
      },
      {
        "height": 16,
        "widget": {
          "title": "Billable instance time",
          "xyChart": {
            "dataSets": [
              {
                "legendTemplate": "billable s/s",
                "plotType": "LINE",
                "targetAxis": "Y1",
                "timeSeriesQuery": {
                  "timeSeriesFilter": {
                    "aggregation": {
                      "alignmentPeriod": "60s",
                      "crossSeriesReducer": "REDUCE_SUM",
                      "perSeriesAligner": "ALIGN_RATE"
                    },
                    "filter": "metric.type=\"run.googleapis.com/container/billable_instance_time\" AND resource.type=\"cloud_run_revision\" AND resource.labels.service_name=\"shipit\""
                  }
                }
              }
            ],
            "timeshiftDuration": "0s",
            "yAxis": {
              "label": "s/s",
              "scale": "LINEAR"
            }
          }
        },
        "width": 16,
        "xPos": 32,
        "yPos": 43
      },
      {
        "height": 16,
        "widget": {
          "title": "Uptime check latency by region",
          "xyChart": {
            "dataSets": [
              {
                "legendTemplate": "${metric.labels.checker_location}",
                "plotType": "LINE",
                "targetAxis": "Y1",
                "timeSeriesQuery": {
                  "timeSeriesFilter": {
                    "aggregation": {
                      "alignmentPeriod": "300s",
                      "crossSeriesReducer": "REDUCE_MEAN",
                      "groupByFields": [
                        "metric.label.checker_location"
                      ],
                      "perSeriesAligner": "ALIGN_MEAN"
                    },
                    "filter": "metric.type=\"monitoring.googleapis.com/uptime_check/request_latency\" AND resource.type=\"uptime_url\" AND metric.label.check_id=\"shipit-health-mPyRhihDCZ4\""
                  }
                }
              }
            ],
            "timeshiftDuration": "0s",
            "yAxis": {
              "label": "ms",
              "scale": "LINEAR"
            }
          }
        },
        "width": 24,
        "yPos": 59
      },
      {
        "height": 16,
        "widget": {
          "logsPanel": {
            "filter": "resource.type=\"cloud_run_revision\" AND resource.labels.service_name=\"shipit\" AND severity>=WARNING",
            "resourceNames": [
              "projects/devops-playground-14386"
            ]
          },
          "title": "Recent logs (errors & warnings)"
        },
        "width": 24,
        "xPos": 24,
        "yPos": 59
      }
    ]
  }
}
